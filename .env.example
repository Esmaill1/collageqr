# Copy this file to .env and fill in the values.
# cp .env.example .env

# Neon Postgres connection string (get it from the Neon console)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Non-pooled Neon URL for migrations (Neon console → "direct" / pgbouncer-off connection)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Secret used to sign focus-session JWTs — set a long random value in production
JWT_SECRET="change-me-in-production"

# Admin dashboard password (set a long random value)
ADMIN_TOKEN="set-a-long-random-admin-password"

# Public app URL used by stickers to build QR target URLs.
# In dev it defaults to https://desklore.vercel.app — set it to your real
# domain in production so printed sticker QRs point to the right place.
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# Optional. Only used by scripts/seed.ts to generate varied seed notes via
# gemini-2.5-flash. If unset, the seed script falls back to a built-in note pool.
GEMINI_API_KEY=""

# Copy this file to .env and fill in the values.
# cp .env.example .env

# Neon Postgres connection string (get it from the Neon console)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Secret used to sign focus-session JWTs — set a long random value in production
JWT_SECRET="change-me-in-production"

# Admin dashboard password (set a long random value)
ADMIN_TOKEN="set-a-long-random-admin-password"

# Public app URL used by stickers to build QR target URLs.
# Use localhost for local previews; set the real domain before printing
# production stickers.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
